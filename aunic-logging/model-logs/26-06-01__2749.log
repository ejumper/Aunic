    {
      "command": "cat \u003c\u003c 'EOF' \u003e count_conflicts.sh\n#!/bin/bash\nmkdir -p git_rebase_test_script\ncd git_rebase_test_script\ngit init\ngit branch -m main\ngit commit --allow-empty -m \"Initial commit\"\n\n# Create base file\necho \"line 1\" \u003e file.txt\necho \"line 2\" \u003e\u003e file.txt\necho \"line 3\" \u003e\u003e file.txt\ngit add file.txt\ngit commit -m \"base\"\n\n# Create feature branch with 3 commits\ngit checkout -b feature\necho \"feat 1\" \u003e file.txt\necho \"line 2\" \u003e\u003e file.txt\necho \"line 3\" \u003e\u003e file.txt\ngit add file.txt\ngit commit -m \"feat 1\"\n\necho \"feat 1\" \u003e file.txt\necho \"feat 2\" \u003e\u003e file.txt\necho \"line 3\" \u003e\u003e file.txt\ngit add file.txt\ngit commit -m \"feat 2\"\n\necho \"feat 1\" \u003e file.txt\necho \"feat 2\" \u003e\u003e file.txt\necho \"feat 3\" \u003e\u003e file.txt\ngit add file.txt\ngit commit -m \"feat 3\"\n\n# Create main branch with 3 commits that conflict with each one\ngit checkout main\necho \"main 1\" \u003e file.txt\necho \"line 2\" \u003e\u003e file.txt\necho \"line 3\" \u003e\u003e file.txt\ngit add file.txt\ngit commit -m \"main 1\"\n\necho \"main 1\" \u003e file.txt\necho \"main 2\" \u003e\u003e file.txt\necho \"line 3\" \u003e\u003e file.txt\ngit add file.txt\ngit commit -m \"main 2\"\n\necho \"main 1\" \u003e file.txt\necho \"main 2\" \u003e\u003e file.txt\necho \"main 3\" \u003e\u003e file.txt\ngit add file.txt\ngit commit -m \"main 3\"\n\n# Run rebase and count conflicts\ngit checkout feature\nconflict_count=0\nwhile true; do\n    git rebase main\n    if [ $? -eq 0 ]; then\n        break\n    else\n        conflict_count=$((conflict_count + 1))\n        # Resolve conflict by accepting \"both\" or just adding\n        git add file.txt\n        git rebase --continue\n    fi\ndone\n\necho \"CONFLICT_COUNT=$conflict_count\"\nEOF\n\nchmod +x count_conflicts.sh\n./count_conflicts.sh",
