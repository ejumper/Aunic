    ### 3. Implementation Strategy for `XMLHttpRequest`
    In QML, your fetch logic will look something like this:
    
    ```javascript
    function fetchJellyfinImages() {
        var xhr = new XMLHttpRequest();
        xhr.onreadystatechange = function() {
            if (xhr.readyState === XMLHttpRequest.DONE) {
                if (xhr.status === 200) {
                    var response = JSON.parse(xhr.responseText);
                    // Logic to extract image URLs and populate ListModel
                }
            }
        }
        xhr.open("GET", "https://media.halfab.net/Users/YOUR_ID/Items?IncludeImages=true&Recursive=true");
        xhr.setRequestHeader("X-Emby-Token", "YOUR_API_KEY");
        xhr.send();
    }
    ```
    
