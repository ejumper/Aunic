    ### 2. The Tracker Service (D-Bus Listener)
    **File:** `~/.config/systemd/user/jellyfin-wallpaper-tracker.service`
    
    ```ini
    [Unit]
    Description=Jellyfin Wallpaper Lock Tracker
    
    [Service]
    Type=simple
    ExecStart=/usr/bin/bash -c 'dbus-monitor --system "type=\"signal\"",interface="org.freedesktop.login1.Session",member="Lock",member="Unlock" | while read line; do \
      STATE_FILE="$HOME/.local/share/jellyfin-wallpapers/state.json"; \
      if echo "$line" | grep -q "Lock"; then \
        echo "$(date +%%s)" > "$STATE_FILE.lock_start"; \
      elif echo "$line" | grep -q "Unlock" && [ -f "$STATE_FILE.lock_start" ]; then \
        START=$(cat "$STATE_FILE.lock_start"); \
        NOW=$(date +%%s); \
        DIFF=$(( (NOW - START) / 60 )); \
        jq ".locked_minutes_accumulated += $DIFF" "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"; \
        rm "$STATE_FILE.lock_start"; \
      fi; \
    done'
    Restart=always
    
    [Install]
    WantedBy=default.target
    ```
    
    ---
    
    ### 3. The Sync Timer & Service
    **File 1:** `~/.config/systemd/user/jellyfin-wallpaper-sync.service`
    ```ini
    [Unit]
    Description=Jellyfin Wallpaper Sync
    
    [Service]
    Type=oneshot
    ExecStart=%h/Scripts-Apps-Plugins/Scripts/lock-screen.bash
    ```
    
    **File 2:** `~/.config/systemd/user/jellyfin-wallpaper-sync.timer`
    ```ini
    [Unit]
    Description=Run Jellyfin Wallpaper Sync every 15 mins
    
    [Timer]
    OnBootSec=5min
    OnUnitActiveSec=15min
    
    [Install]
    WantedBy=timers.target
    ```
    
