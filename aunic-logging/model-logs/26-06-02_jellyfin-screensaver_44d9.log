    ### 1. The Main Script
    **File:** `~/Scripts-Apps-Plugins/Scripts/lock-screen.bash`
    *(Make sure to `chmod +x` this file after creating it)*
    
    ```bash
    #!/bin/bash
    
    # --- CONFIGURATION ---
    API_KEY="a1fd400577d44b39a82f89471d2e7e92"
    SERVER_URL="https://media.halfab.net"
    IMAGE_DIR="$HOME/.local/share/jellyfin-wallpapers"
    STATE_FILE="$HOME/.local/share/jellyfin-wallpapers/state.json"
    LOG_FILE="$HOME/.local/share/jellyfin-wallpapers/sync.log"
    
    # Limits
    MIN_IMAGES=25
    MAX_DIR_SIZE_GB=15
    SEED_COUNT=50
    LOCK_RATIO=10 # 1 image per 10 mins
    
    # --- PREP ---
    mkdir -p "$IMAGE_DIR"
    touch "$LOG_FILE"
    
    # Initialize state if not exists
    if [ ! -f "$STATE_FILE" ]; then
        echo "{\"locked_minutes_accumulated\": 0, \"last_active_date\": \"$(date +%Y-%m-%d)\", \"lock_started_at\": null, \"image_count\": 0}" > "$STATE_FILE"
    fi
    
    log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"; }
    
    # --- HELPERS ---
    get_state() { jq -r "$1" "$STATE_FILE"; }
    update_state() {
        local tmp=$(mktemp)
        jq "$1" "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
    }
    
    # --- LOGIC ---
    
    # 1. Cleanup Logic (Daily/Cap)
    check_cleanup() {
        local current_date=$(date +%Y-%m-%d)
        local last_date=$(get_state ".last_active_date")
        local locked_mins=$(get_state ".locked_minutes_accumulated")
        local dir_size=$(du -sb "$IMAGE_DIR" | cut -f1)
        local max_size=$((MAX_DIR_SIZE_GB * 1024 * 1024 * 1024))
        
        local delete_count=0
    
        # Check if it was an inactive day (0 lock mins)
        if [[ "$last_date" != "$current_date" && "$locked_mins" -eq 0 ]]; then
            delete_count=2
            log "Inactive day detected. Scheduling deletion of 2 images."
        fi
    
        # Check if cap is met
        if [ "$dir_size" -gt "$max_size" ]; then
            delete_count=5
            log "Storage cap reached ($MAX_DIR_SIZE_GB GB). Scheduling deletion of 5 images."
        fi
    
        if [ "$delete_count" -gt 0 ]; then
            # Find oldest files (by modification time)
            local files_to_del=$(find "$IMAGE_DIR" -type f -printf '%T+ %p\n' | sort | head -n "$delete_count" | cut -d' ' -f2-)
            if [ -n "$files_to_del" ]; then
                echo "$files_to_del" | xargs rm
                log "Deleted: $files_to_del"
            fi
        fi
    
        # Update state for next day
        update_state ".last_active_date = \"$current_date\" | .locked_minutes_accumulated = 0"
    }
    
    # 2. Download Logic
    download_images() {
        local target_count=$1
        if [ "$target_count" -le 0 ]; then return; fi
    
        log "Attempting to download $target_count images..."
    
        # Fetch items (Movies, Series, Artists) with backdrops
        local items_url="${SERVER_URL}/Items?IncludeItemTypes=Movie,Series,MusicArtist&ImageTypes=Backdrop&Recursive=true&api_key=${API_KEY}"
        local response=$(curl -s "$items_url")
        
        # Get item IDs and their backdrop counts (simplified for bash)
        # We'll grab a random sample of IDs from the response
        local item_ids=$(echo "$response" | jq -r '.Items[].Id' | shuf -n 100)
    
        local downloaded=0
        for id in $item_ids; do
            [ "$downloaded" -ge "$target_count" ] && break
    
            # For each item, try to find all backdrop indices
            # In a real implementation, we'd check the BackdropImageTags, 
            # but here we'll just try index 0, 1, 2... until 404
            local idx=0
            while [ $idx -lt 5 ]; do
                local img_url="${SERVER_URL}/Items/${id}/Images/Backdrop/${idx}?api_key=${API_KEY}"
                local out_file="${IMAGE_DIR}/${id}_backdrop_${idx}.jpg"
                
                if curl -s -o "$out_file" "$img_url"; then
                    # Verify it's a real image (not a 404 error page)
                    if file "$out_file" | grep -q "JPEG"; then
                        ((downloaded++))
                        ((idx++))
                        [ "$downloaded" -ge "$target_count" ] && break
                    else
                        rm "$out_file"
                        break # No more backdrops for this item
                    fi
                else
                    break
                fi
            done
        done
        log "Downloaded $downloaded images."
    }
    
    # --- EXECUTION ---
    
    # If running as "seed"
    if [ "$1" == "--seed" ]; then
        log "Seeding initial images..."
        download_images "$SEED_COUNT"
        update_state ".image_count = $SEED_COUNT"
        exit 0
    fi
    
    # Regular Sync Run
    check_cleanup
    
    local locked_mins=$(get_state ".locked_minutes_accumulated")
    local to_download=$(( locked_mins / LOCK_RATIO ))
    
    if [ "$to_download" -gt 0 ]; then
        download_images "$to_download"
        update_state ".locked_minutes_accumulated = 0"
    fi
    
    # Final count check (ensure min floor)
    local current_count=$(find "$IMAGE_DIR" -type f | wc -l)
    if [ "$current_count" -lt "$MIN_IMAGES" ]; then
        local needed=$(( MIN_IMAGES - current_count ))
        download_images "$needed"
    fi
    ```
    
