    ### 2. Implementation Files
    
    #### A. The Tracker Script
    **File**: `~/Scripts-Apps-Plugins/Scripts/lock-screen-tracker.sh`
    
    ```bash
    #!/bin/bash
    # ~/Scripts-Apps-Plugins/Scripts/lock-screen-tracker.sh
    
    STATE_DIR="$HOME/.local/share/jellyfin-wallpapers"
    STATE_FILE="$STATE_DIR/state.json"
    mkdir -p "$STATE_DIR"
    
    # Initialize state if not exists
    if [ ! -f "$STATE_FILE" ]; then
        echo "{\"locked_minutes_accumulated\": 0, \"last_active_date\": \"$(date +%Y-%m-%d)\", \"lock_started_at\": null, \"image_count\": 0}" > "$STATE_FILE"
    fi
    
    echo "Starting Jellyfin Lock Tracker..."
    
    # Listen for Lock/Unlock via dbus-monitor
    # We use --system because login1 is a system bus service
    dbus-monitor --system "type='signal',interface='org.freedesktop.login1.Session',member='Lock'" | while read -r line; do
        if echo "$line" | grep -q "member='Lock'"; then
            jq --arg ts "$(date +%s)" '.lock_started_at = ($ts|tonumber)' "$STATE_FILE" > "${STATE_FILE}.tmp" && mv "${STATE_FILE}.tmp" "$STATE_FILE"
        fi
    done &
    
    dbus-monitor --system "type='signal',interface='org.freedesktop.login1.Session',member='Unlock'" | while read -r line; do
        if echo "$line" | grep -q "member='Unlock'"; then
            START_TS=$(jq '.lock_started_at' "$STATE_FILE")
            if [ "$START_TS" != "null" ]; then
                END_TS=$(date +%s)
                DIFF=$(( (END_TS - START_TS) / 60 ))
                jq --arg diff "$DIFF" '.locked_minutes_accumulated += ($diff|tonumber) | .lock_started_at = null' "$STATE_FILE" > "${STATE_FILE}.tmp" && mv "${STATE_FILE}.tmp" "$STATE_FILE"
            fi
        fi
    done
    
    wait
    ```
    
    #### B. The Sync Script
    **File**: `~/Scripts-Apps-Plugins/Scripts/lock-screen.bash`
    
    ```bash
    #!/bin/bash
    # ~/Scripts-Apps-Plugins/Scripts/lock-screen.bash
    
    # --- CONFIGURATION ---
    API_KEY="a1fd400577d44b39a82f89471d2e7e92"
    BASE_URL="https://media.halfab.net"
    DIR="$HOME/.local/share/jellyfin-wallpapers"
    STATE_FILE="$DIR/state.json"
    MAX_SIZE_GB=15
    MIN_IMAGES=25
    # ---------------------
    
    mkdir -p "$DIR"
    
    # Load State
    if [ ! -f "$STATE_FILE" ]; then
        echo "{\"locked_minutes_accumulated\": 0, \"last_active_date\": \"$(date +%Y-%m-%d)\", \"lock_started_at\": null, \"image_count\": 0}" > "$STATE_FILE"
    fi
    
    get_state() { jq -r "$1" "$STATE_FILE"; }
    update_state() { jq "$1" "$STATE_FILE" > "${STATE_FILE}.tmp" && mv "${STATE_FILE}.tmp" "$STATE_FILE"; }
    
    ACCUMULATED_MIN=$(get_state ".locked_minutes_accumulated")
    LAST_DATE=$(get_state ".last_active_date")
    IMG_COUNT=$(get_state ".image_count")
    TODAY=$(date +%Y-%m-%d)
    
    # 1. Handle Shrinkage (Inactive Day)
    if [ "$LAST_DATE" != "$TODAY" ] && [ "$ACCUMULATED_MIN" -eq 0 ]; then
        # Determine deletion amount based on size cap
        DIR_SIZE_BYTES=$(du -sb "$DIR" | cut -f1)
        CAP_BYTES=$(( MAX_SIZE_GB * 1024 * 1024 * 1024 ))
        
        if [ "$DIR_SIZE_BYTES" -gt "$CAP_BYTES" ]; then DEL_COUNT=5; else DEL_COUNT=2; fi
        
        # Ensure we don't drop below floor
        if [ "$IMG_COUNT" -gt "$MIN_IMAGES" ]; then
            # Delete oldest files
            find "$DIR" -type f -name "*.jpg" -printf '%T+ %p\n' | sort | head -n "$DEL_COUNT" | cut -d' ' -f2- | xargs rm -f
            NEW_COUNT=$(( IMG_COUNT - DEL_COUNT ))
            [ "$NEW_COUNT" -lt "$MIN_IMAGES" ] && NEW_COUNT=$MIN_IMAGES
            update_state ".image_count = $NEW_COUNT | .last_active_date = \"$TODAY\""
        else
            update_state ".last_active_date = \"$TODAY\""
        fi
    fi
    
    # 2. Handle Growth (Seed or Accumulation)
    TARGET_DOWNLOADS=0
    if [ "$IMG_COUNT" -eq 0 ]; then
        TARGET_DOWNLOADS=50
    elif [ "$ACCUMULATED_MIN" -ge 10 ]; then
        TARGET_DOWNLOADS=$(( ACCUMULATED_MIN / 10 ))
        update_state ".locked_minutes_accumulated = 0"
    fi
    
    if [ "$TARGET_DOWNLOADS" -gt 0 ]; then
        # Fetch items
        ITEMS_JSON=$(curl -s "$BASE_URL/Items?IncludeItemTypes=Movie,Series,MusicArtist&ImageTypes=Backdrop&Recursive=true&api_key=$API_KEY")
        
        # Get list of IDs and Backdrop counts
        # We extract ID and the size of the BackdropImageTags array
        ITEM_DATA=$(echo "$ITEMS_JSON" | jq -c '.Items[] | {id: .Id, tags: (.BackdropImageTags | length)}')
        
        DOWNLOADED=0
        # Shuffle items by converting to array and picking randoms
        while [ "$DOWNLOADED" -lt "$TARGET_DOWNLOADS" ]; do
            # Pick a random item from the list
            RANDOM_ITEM=$(echo "$ITEM_DATA" | shuf -n 1)
            ID=$(echo "$RANDOM_ITEM" | jq -r '.id')
            TAG_COUNT=$(echo "$RANDOM_ITEM" | jq -r '.tags')
    
            if [ "$TAG_COUNT" -gt 0 ]; then
                for (( i=0; i<TAG_COUNT; i++ )); do
                    if [ "$DOWNLOADED" -lt "$TARGET_DOWNLOADS" ]; then
                        IMG_URL="$BASE_URL/Items/$ID/Images/Backdrop/$i?api_key=$API_KEY"
                        FILE_NAME="${ID}_backdrop_${i}.jpg"
                        curl -s "$IMG_URL" -o "$DIR/$FILE_NAME"
                        ((DOWNLOADED++))
                    fi
                done
            fi
            
            # Safety break if we run out of items
            if [ "$(echo "$ITEM_DATA" | wc -l)" -eq 0 ]; then break; fi
        done
        
        NEW_TOTAL=$(( IMG_COUNT + DOWNLOADED ))
        update_state ".image_count = $NEW_TOTAL"
    fi
    ```
    
    #### C. Systemd User Units
    
    **File**: `~/.config/systemd/user/jellyfin-wallpaper-tracker.service`
    ```ini
    [Unit]
    Description=Jellyfin Lock Time Tracker
    
    [Service]
    ExecStart=%h/Scripts-Apps-Plugins/Scripts/lock-screen-tracker.sh
    Restart=always
    
    [Install]
    WantedBy=default.target
    ```
    
    **File**: `~/.config/systemd/user/jellyfin-wallpaper-sync.service`
    ```ini
    [Unit]
    Description=Jellyfin Wallpaper Sync
    
    [Service]
    ExecStart=%h/Scripts-Apps-Plugins/Scripts/lock-screen.bash
    ```
    
    **File**: `~/.config/systemd/user/jellyfin-wallpaper-sync.timer`
    ```ini
    [Unit]
    Description=Run Jellyfin Wallpaper Sync every 15 minutes
    
    [Timer]
    OnBootSec=1min
    OnUnitActiveSec=15min
    
    [Install]
    WantedBy=timers.target
    ```
    
