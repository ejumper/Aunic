003e /dev/null 2\u003e\u00261\n\n# 5. Try to rebase feature onto main\ngit checkout feature \u003e /dev/null 2\u003e\u00261\n\nconflict_count=0\n\n# We'll use a loop to handle the rebase.\n# git rebase returns non-zero if there is a conflict.\n\n# First, attempt the rebase.\ngit rebase main \u003e /dev/null 2\u003e\u00261\n\nwhile [ $? -ne 0 ]; do\n    # Check if there are unmerged files (conflicts)\n    if git ls-files -u | grep -q .; then\n        ((conflict_count++))\n        # Resolve conflict by picking the feature branch's version\n        # In a rebase, 'theirs' is the branch being applied (the feature branch commit)\n        # 'ours' is the branch we are rebasing onto (main)\n        git checkout --theirs file.txt \u003e /dev/null 2\u003e\u00261\n        git add file.txt \u003e /dev/null 2\u003e\u00261\n        git rebase --continue --no-edit \u003e /dev/null 2\u003e\u00261\n    else\n        # If it failed for some other reason, break to avoid infinite loop\n        break\n    fi\ndone\n\necho \"Total conflicts encountered: $conflict_count\"\n",
