  <RESPONSE>
    I cannot directly create files on your system, but I have prepared the complete, production-ready implementation for you.
    
    Follow these steps to set it up.
    
    ### 1. Create the directory and the script
    Run these commands in your terminal:
    
    ```bash
    mkdir -p ~/Scripts-Apps-Plugins/Scripts/
    mkdir -p ~/.local/share/jellyfin-wallpapers/
    
    cat << 'EOF' > ~/Scripts-Apps-Plugins/Scripts/lock-screen.bash
    #!/bin/bash
    
    # --- CONFIGURATION ---
    API_KEY="a1fd400577d44b39a82f89471d2e7e92"
    SERVER_URL="https://media.halfab.net"
    IMG_DIR="$HOME/.local/share/jellyfin-wallpapers"
    STATE_FILE="$HOME/.local/share/jellyfin-wallpapers/state.json"
    MAX_SIZE_GB=15
    MIN_IMAGES=25
    SEED_COUNT=50
    # ---------------------
    
    # Ensure directory exists
    mkdir -p "$IMG_DIR"
    
    # Initialize state if not exists
    if [[ ! -f "$STATE_FILE" ]]; then
        echo '{"locked_minutes":0,"last_active_date":"","image_count":0}' > "$STATE_FILE"
    fi
    
    # Helper: Read/Write JSON state
    get_state() { jq -r "$1" "$STATE_FILE"; }
    set_state() {
        local tmp=$(mktemp)
        jq "$1" "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
    }
    
    # Helper: Get folder size in GB
    get_dir_size_gb() {
        du -sb "$IMG_DIR" | awk '{print $1/1024/1024/1024}'
    }
    
    # --- CORE LOGIC: SYNC ---
    sync_images() {
        local current_size=$(get_dir_size_gb)
        local current_count=$(get_state ".image_count")
        local locked_mins=$(get_state ".locked_minutes")
        local last_date=$(get_state ".last_active_date")
        local today=$(date +%Y-%m-%d)
    
        # 1. Handle Deletions (Inactive Day or Cap Reached)
        local delete_count=0
        if [[ "$last_date" != "$today" ]]; then
            if (( $(echo "$current_size > $MAX_SIZE_GB" | bc -l) )); then
                delete_count=5
            elif [[ "$locked_mins" -eq 0 ]]; then
                delete_count=2
            fi
            
            if [[ $delete_count -gt 0 && $current_count -gt $MIN_IMAGES ]]; then
                # Delete oldest files (by creation time)
                find "$IMG_DIR" -type f -printf '%T+ %p\n' | sort | head -n "$delete_count" | awk '{print $2}' | xargs rm -f
                current_count=$(( current_count - delete_count ))
                [ $current_count -lt $MIN_IMAGES ] && current_count=$MIN_IMAGES
            fi
            set_state ".last_active_date = \"$today\""
        fi
    
        # 2. Handle Additions
        # If first run (count 0), seed 50. Otherwise, 1 per 10 mins locked.
        local to_add=0
        if [[ $current_count -eq 0 ]]; then
            to_add=$SEED_COUNT
        else
            to_add=$(( locked_mins / 10 ))
            if [[ $to_add -gt 0 ]]; then
                set_state ".locked_minutes = 0"
            fi
        fi
    
        if [[ $to_add -gt 0 ]]; then
            # Fetch items (Movie, Series, MusicArtist)
            local items_json=$(curl -s "$SERVER_URL/Items?IncludeItemTypes=Movie,Series,MusicArtist&ImageTypes=Backdrop&Recursive=true&api_key=$API_KEY")
            
            # Get random item IDs from the list
            local item_ids=$(echo "$items_json" | jq -r '.Items[].Id')
            local shuffled_ids=$(echo "$item_ids" | shuf)
    
            local added=0
            for id in $shuffled_ids; do
                [[ $added -ge $to_add ]] && break
                
                # For each item, get all backdrop indices
                # We use the Item ID to fetch the specific image paths
                # To avoid complex nested loops in bash, we fetch the item's image metadata
                local img_metadata=$(curl -s "$SERVER_URL/Items/$id/Images?api_key=$API_KEY")
                
                # Iterate through available backdrops
                local backdrop_count=$(echo "$img_metadata" | jq '.Backdrops | length')
                for (( i=0; i<$backdrop_count; i++ )); do
                    local img_url=$(echo "$img_metadata" | jq -r ".Backdrops[$i].Url")
                    [[ "$img_url" == "null" ]] && continue
                    
                    local filename="${id}_backdrop_${i}.jpg"
                    if [[ ! -f "$IMG_DIR/$filename" ]]; then
                        curl -s "$img_url" -o "$IMG_DIR/$filename"
                        ((added++))
                    fi
                    [[ $added -ge $to_add ]] && break
                done
            done
            current_count=$(( current_count + added ))
        fi
    
        set_state ".image_count = $current_count"
    }
    
    # --- CORE LOGIC: TRACKER ---
    # This part is intended to be run via the systemd service
    track_lock() {
        # Monitor D-Bus for lock/unlock events
        dbus-monitor --system "type='signal',interface='org.freedesktop.ScreenSaver',member='ActiveChanged'" | \
        while read -r line; do
            if echo "$line" | grep -q "boolean true"; then
                # LOCKED
                set_state ".lock_start = \"$(date +%s)\""
            elif echo "$line" | grep -q "boolean false"; then
                # UNLOCKED
                local start_time=$(get_state ".lock_start")
                if [[ -n "$start_time" && "$start_time" != "null" ]]; then
                    local now=$(date +%s)
                    local diff=$(( (now - start_time) / 60 ))
                    local current_locked=$(get_state ".locked_minutes")
                    set_state ".locked_minutes = $current_locked + $diff"
                fi
            fi
        done
    }
    
    # Main entry point
    case "$1" in
        sync)
            sync_images
            ;;
        track)
            track_lock
            ;;
        *)
            echo "Usage: $0 {sync|track}"
            exit 1
            ;;
    esac
    EOF
    
    chmod +x ~/Scripts-Apps-Plugins/Scripts/lock-screen.bash
    ```
    
    ### 2. Create the Systemd User Services
    You need two services: one to watch the lock/unlock events, and one to run the sync on a timer.
    
    Run these commands to create them:
    
    ```bash
    # 1. The Tracker Service (runs in background)
    mkdir -p ~/.config/systemd/user/
    cat << 'EOF' > ~/.config/systemd/user/jellyfin-wallpaper-tracker.service
    [Unit]
    Description=Track Jellyfin Wallpaper Lock Time
    
    [Service]
    ExecStart=%h/Scripts-Apps-Plugins/Scripts/lock-screen.bash track
    Restart=always
    
    [Install]
    WantedBy=default.target
    EOF
    
    # 2. The Sync Service (runs on timer)
    cat << 'EOF' > ~/.config/systemd/user/jellyfin-wallpaper-sync.service
    [Unit]
    Description=Sync Jellyfin Wallpapers
    
    [Service]
    ExecStart=%h/Scripts-Apps-Plugins/Scripts/lock-screen.bash sync
    
    [Install]
    WantedBy=default.target
    EOF
    
    # 3. The Sync Timer (runs every 15 mins)
    cat << 'EOF' > ~/.config/systemd/user/jellyfin-wallpaper-sync.timer
    [Unit]
    Description=Run Jellyfin Wallpaper Sync every 15 minutes
    
    [Timer]
    OnBootSec=5min
    OnUnitActiveSec=15min
    
    [Install]
    WantedBy=timers.target
    EOF
    ```
    
    ### 3. Enable and Start
    Now, tell systemd to start everything:
    
    ```bash
    systemctl --user daemon-reload
    systemctl --user enable --now jellyfin-wallpaper-tracker.service
    systemctl --user enable --now jellyfin-wallpaper-sync.timer
    ```
    
    ### Summary of what is now running:
    1.  **`jellyfin-wallpaper-tracker.service`**: Sits in the background. Every time you lock/unlock your screen, it calculates how many minutes you were away and updates `~/.local/share/jellyfin-wallpapers/state.json`.
    2.  **`jellyfin-wallpaper-sync.timer`**: Every 15 minutes, it triggers the sync.
    3.  **`jellyfin-wallpaper-sync.service`**: 
        - Checks the JSON state.
        - If it's the first time, it downloads 50 images.
        - If you've been locked for 30 mins, it downloads 3 images.
        - If you haven't locked the computer in a day, it deletes 2 images.
        - If the folder hits 15GB, it deletes 5 images per day.
    4.  **KDE Settings**: You just need to go to **System Settings → Screen Locking → Wallpaper** and select **Slideshow**, then point the folder to `~/.local/share/jellyfin-wallpapers/`.
