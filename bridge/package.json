{
  "name": "@aunic/bridge",
  "version": "0.1.0",
  "description": "Aunic ↔ Claude Agent SDK bridge. Spawned per run by Aunic Go; speaks JSON-lines over stdio.",
  "private": true,
  "type": "module",
  "main": "dist/bridge.js",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/bridge.js --external:@anthropic-ai/claude-agent-sdk",
    "check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.145",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0"
  }
}
